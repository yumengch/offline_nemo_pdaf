! Namelist file for PDAF configuration

&pdaf_nml
  screen = 2
  dim_ens = 2
  filtertype = 7
  subtype = 0
  type_trans = 0
  type_sqrt = 0
  type_forget = 0
  forget = 0.8
  locweight = 2
/

&io_nml
  verbose_io = 2
  sgldbl_io = 'dbl'
  path_dom = '/storage/research/nceo/ia923171/nemo/nemo_5.0.1/cfgs/UOR_ORCA2_ICE/ens_1'
  fname_dom = 'ORCA_R2_zps_domcfg.nc'
  ! the parth to restart files is constructed by the following variables
  ! path_rst_root//ens_prefix[1-N]//path_rst_suffix//f_basename_rst_000x.nc
  path_rst_root = '/storage/research/nceo/ia923171/nemo/nemo_5.0.1/cfgs/UOR_ORCA2_ICE/'
  ! ensemble prefix
  ! ensemble numbers must be from 1 - N, it cannot have zero paddings.
  ens_prefix = 'ens_'
  ! rest of the path to restart files
  path_rst_suffix = '.'
  f_basename_rst = 'ORCA2_00000072_restart'
  ! the parth to increment files is constructed by the following variables
  ! path_asm_root//ens_prefix[1-N]/assim_background_increments_xxxx.nc
  ! path_asm_root//ens_prefix[1-N]/assim_background_state_DI_xxxx.nc
  path_asm_root = '/storage/research/nceo/ia923171/nemo/nemo_5.0.1/cfgs/UOR_ORCA2_ICE/'
  ! initial time of day in hhmm
  nn_time0 = 0
/

&sv_nml
  n_fields=2
  use_wet_state = 2
/

&sfields_nml
  sfields(1)%ndims = 3
  sfields(1)%variable = 'thetao'
  sfields(1)%name_incr = 'bckint'
  sfields(1)%name_rest_n = 'tn'
  sfields(1)%name_rest_b = 'tb'
  sfields(1)%rst_file = 'ORCA2_00000072_restart'
  sfields(1)%unit = 'degC'

  sfields(2)%ndims = 3
  sfields(2)%variable = 'so'
  sfields(2)%name_incr = 'bckins'
  sfields(2)%name_rest_n = 'sn'
  sfields(2)%name_rest_b = 'sb'
  sfields(2)%rst_file = 'ORCA2_00000072_restart'
  sfields(2)%unit = 'psu'
  sfields(2)%transform = 0
  sfields(2)%trafo_shift = 0.0
  sfields(2)%limit = 0
  sfields(2)%min_limit = 0.000001
/

&mgrid_ssh_nml
  assim_ssh_mgrid = .true.
  use_global_obs = 1
  ! this is the index of obs. in sfields for fake obs.
  id_sfields = 1
  rms = 0.5
  lradius = 20000
  sradius = 20000
  noise_amp = 0.5
/

! Physical observations: paths are relative to the analysis working directory.
! Enable only after validating cycle timing, error floors and localization.
&en4_nml
  assim_en4_temp = .false.
  assim_en4_salt = .false.
  id_temp = 1
  id_salt = 2
  path_en4 = 'obsproc'
  prefix_en4 = 'EN.4.2.2.f.analysis.g10.'
  assim_day = 0 ! Monthly: zero selects the final calendar day.
  min_weight = 0.5
  temp_error_floor = 0.5 ! degC; experiment-specific assumption.
  salt_error_floor = 0.1 ! psu; experiment-specific assumption.
  lradius = 20000 ! metres; horizontal localization only.
  sradius = 20000
/

&ostia_nml
  assim_ostia = .false.
  id_temp = 1
  path_ostia = 'obsproc'
  min_pixels = 1
  error_floor = 0.5 ! degC; representation-error floor.
  max_ice_fraction = 0.0
  lradius = 20000 ! metres; horizontal localization only.
  sradius = 20000
/
